  "film_t1_tahmin": 195.192
 },
 {
  "id": "S7-1_B2",
  "sahne": "S7-1-B",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "Dinner before me?!",
  "kaynak": "vc",
  "film_t0_tahmin": 195.552,
  "film_t1_tahmin": 196.432
 },
 {
