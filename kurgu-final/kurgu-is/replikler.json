  "sahne": "S7-1-B",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Geese are punctual.",
  "kaynak": "vc",
  "film_t0_tahmin": 196.852,
  "film_t1_tahmin": 197.612
