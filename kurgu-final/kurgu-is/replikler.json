  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "Not pie. Mama.",
  "kaynak": "vc",
  "film_t0_tahmin": 183.47,
  "film_t1_tahmin": 184.55
 },
 {
  "id": "S6-5_H2",
  "sahne": "S6-5",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Go.",
  "kaynak": "vc",
  "film_t0_tahmin": 184.85,
  "film_t1_tahmin": 185.09
 },
 {
  "id": "S7-1_B1",
