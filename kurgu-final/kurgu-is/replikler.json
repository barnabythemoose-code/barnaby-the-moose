  "film_t1_tahmin": 192.372
 },
 {
  "id": "S7-1_H2",
  "sahne": "S7-1-B",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "They eat Mama's corn at the lights. They know the way.",
  "kaynak": "vc",
