  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "Excuse me, sir. Which way to Mama's table?",
  "kaynak": "s5",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S5-2_B31",
  "sahne": "S5-2c",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "He didn't answer.",
  "kaynak": "s5",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S5-2_H32",
  "sahne": "S5-2c",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "He's a tree, and that's three times.",
  "kaynak": "s5",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S5-3_B33",
  "sahne": "S5-3a",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "No bell.",
  "kaynak": "s5",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S5-3_H34",
  "sahne": "S5-3b",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "The fog swallows sound, Barnaby. Maybe we just can't hear it.",
  "kaynak": "s5",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S5-3_B35",
  "sahne": "S5-3b",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "Papa never waits. They've started.",
  "kaynak": "s5",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S5-3_B36",
  "sahne": "S5-3b",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "We're lost.",
  "kaynak": "s5",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S5-3_H37",
  "sahne": "S5-3b",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Then we stop and think.",
  "kaynak": "s5",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S6-1_H1",
  "sahne": "S6-1",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "We stop here until morning.",
