[
 {
  "id": "S3-3_B3",
  "sahne": "S3-3",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "Cinnamon and warm wool. That's Mama's table.",
  "kaynak": "blok",
  "film_t0_tahmin": 41.23,
  "film_t1_tahmin": 43.73
 },
 {
  "id": "S3-3_H4",
  "sahne": "S3-3",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Three ridges to the lights, but the sun is getting low.",
  "kaynak": "blok",
  "film_t0_tahmin": 44.03,
  "film_t1_tahmin": 46.93
 },
 {
  "id": "S3-3_B5",
  "sahne": "S3-3",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "Then let's follow the scent!",
  "kaynak": "blok",
  "film_t0_tahmin": 47.63,
  "film_t1_tahmin": 49.03
 },
 {
  "id": "S3-4_B6",
  "sahne": "S3-4ff",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "Pie! Papa's pie! It smells so sweet!",
  "kaynak": "blok",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S3-4_H7",
  "sahne": "S3-4ff",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Sweet, yes. But where did the wool go?",
  "kaynak": "blok",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S3-4_B8",
  "sahne": "S3-4ff",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "The pie is so big, it ate the wool.",
  "kaynak": "blok",
  "film_t0_tahmin": null,
  "film_t1_tahmin": null
 },
 {
  "id": "S3-5_H9",
  "sahne": "S3-5",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Barnaby, the wool is gone. Let's stop and sniff properly.",
  "kaynak": "blok",
  "film_t0_tahmin": 59.26,
  "film_t1_tahmin": 62.46
 },
 {
  "id": "S3-5_B10",
  "sahne": "S3-5",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "One little sniff of pie, then wool. Promise.",
  "kaynak": "blok",
  "film_t0_tahmin": 62.76,
  "film_t1_tahmin": 65.06
 },
 {
  "id": "S3-5_H11",
  "sahne": "S3-5",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "This is a bad idea.",
  "kaynak": "blok",
  "film_t0_tahmin": 66.06,
  "film_t1_tahmin": 67.46
 },
 {
  "id": "S4-1_H12",
  "sahne": "S4-1",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Barnaby, open your eyes. That's a tree.",
  "kaynak": "blok",
  "film_t0_tahmin": 70.46,
  "film_t1_tahmin": 72.76
 },
 {
  "id": "S4-1_B13",
  "sahne": "S4-1",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "I don't need eyes. I have a nose.",
  "kaynak": "blok",
  "film_t0_tahmin": 72.96,
  "film_t1_tahmin": 74.76
 },
 {
  "id": "S4-2_B14",
  "sahne": "S4-2",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "That's not pie.",
  "kaynak": "blok",
  "film_t0_tahmin": 79.46,
  "film_t1_tahmin": 80.46
 },
 {
  "id": "S4-2_H15",
  "sahne": "S4-2",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Tree sugar. The wind turned and hid Mama's smell.",
  "kaynak": "blok",
  "film_t0_tahmin": 80.86,
  "film_t1_tahmin": 83.56
 },
 {
  "id": "S4-2_B16",
  "sahne": "S4-2",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "So the pie was a tree.",
  "kaynak": "blok",
  "film_t0_tahmin": 83.86,
  "film_t1_tahmin": 85.16
 },
 {
  "id": "S4-3_H17",
  "sahne": "S4-3",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "That's the second bell. Papa's hurry bell.",
  "kaynak": "blok",
  "film_t0_tahmin": 86.96,
  "film_t1_tahmin": 89.26
 },
 {
  "id": "S4-3_B18",
  "sahne": "S4-3",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "Behind us?",
  "kaynak": "blok",
  "film_t0_tahmin": 89.36,
  "film_t1_tahmin": 90.36
 },
 {
  "id": "S4-3_H19",
  "sahne": "S4-3",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "The geese knew.",
  "kaynak": "blok",
  "film_t0_tahmin": 91.16,
  "film_t1_tahmin": 92.16
 },
 {
  "id": "S4-3_B20",
  "sahne": "S4-3",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "I followed my nose the wrong way.",
  "kaynak": "blok",
  "film_t0_tahmin": 92.76,
  "film_t1_tahmin": 94.76
 },
 {
  "id": "S4-4_H21",
  "sahne": "S4-4",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Last bell is sunset, then Papa sits everyone down.",
  "kaynak": "blok",
  "film_t0_tahmin": 95.92,
  "film_t1_tahmin": 98.82
 },
 {
  "id": "S4-4_B22",
  "sahne": "S4-4",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "Papa never waits.",
  "kaynak": "blok",
  "film_t0_tahmin": 98.82,
  "film_t1_tahmin": 100.02
 },
 {
  "id": "S4-4_H23",
  "sahne": "S4-4",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Three ridges before, now five.",
  "kaynak": "blok",
  "film_t0_tahmin": 100.02,
  "film_t1_tahmin": 101.62
 },
 {
  "id": "S4-4_B24",
  "sahne": "S4-4",
  "kim": "Barnaby",
  "voice_id": "ByzFtP0GwTvCdhGhmMMp",
  "metin": "Five?",
  "kaynak": "blok",
  "film_t0_tahmin": 102.82,
  "film_t1_tahmin": 103.62
 },
 {
  "id": "S4-4_H25",
  "sahne": "S4-4",
  "kim": "Hazel",
  "voice_id": "LXPbTpuiEL499GSZn0FC",
  "metin": "Run!",
  "kaynak": "blok",
  "film_t0_tahmin": 103.62,
  "film_t1_tahmin": 104.22
 },
 {
